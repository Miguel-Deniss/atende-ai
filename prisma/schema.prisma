generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  document             String?
  phone                String?
  address              String?
  hours                String?
  welcomeMessage       String?
  absenceMessage       String?
  status               CompanyStatus       @default(ACTIVE)
  planType             PlanType            @default(STARTER)
  subscriptionStatus   SubscriptionStatus? @default(TRIALING)
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  trialEndsAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?
  aiContext            String?
  aiConfig             AIConfig?
  apiKeys              ApiKey[]
  appointments         Appointment[]
  auditLogs            AuditLog[]
  clients              Client[]
  settings             CompanySettings?
  conversations        Conversation[]
  uploads              Upload[]
  users                User[]
  whatsAppConfig       WhatsAppConfig?
  subscription         Subscription?
  billingHistory       BillingHistory[]

  @@map("companies")
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  name                   String
  passwordHash           String?
  role                   UserRole       @default(EMPLOYEE)
  phone                  String?
  avatarUrl              String?
  emailVerified          Boolean        @default(false)
  emailVerificationToken String?        @unique
  resetPasswordToken     String?        @unique
  resetPasswordExpires   DateTime?
  twoFactorSecret        String?
  twoFactorEnabled       Boolean        @default(false)
  twoFactorVerified      Boolean        @default(false)
  twoFactorRecoveryCodes Json?
  googleId               String?        @unique
  microsoftId            String?        @unique
  lastLoginAt            DateTime?
  lastLoginIp            String?
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  deletedAt              DateTime?
  companyId              String
  auditLogs              AuditLog[]
  loginAttempts          LoginAttempt[]
  sessions               Session[]
  uploads                Upload[]
  handledConversations   Conversation[] @relation("ConversationHandledBy")
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model CompanySettings {
  id                  String   @id @default(cuid())
  autoTransfer        Boolean  @default(true)
  autoReminders       Boolean  @default(true)
  requireConfirmation Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  companyId           String   @unique
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model AIConfig {
  id             String    @id @default(cuid())
  model          String    @default("gpt-4")
  temperature    Float     @default(0.7)
  maxTokens      Int       @default(1024)
  systemPrompt   String?
  welcomeMessage String?
  absenceMessage String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companyId      String    @unique
  instructions   String?
  personality    String?
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  faq            FAQ[]
  services       Service[]

  @@map("ai_configs")
}

model Service {
  id         String   @id @default(cuid())
  name       String
  price      String
  aiConfigId String
  createdAt  DateTime @default(now())
  aiConfig   AIConfig @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)

  @@index([aiConfigId])
  @@map("services")
}

model FAQ {
  id         String   @id @default(cuid())
  question   String
  answer     String
  aiConfigId String
  createdAt  DateTime @default(now())
  aiConfig   AIConfig @relation(fields: [aiConfigId], references: [id], onDelete: Cascade)

  @@index([aiConfigId])
  @@map("faqs")
}

model Client {
  id            String         @id @default(cuid())
  name          String
  phone         String
  email         String?
  whatsappName  String?
  lastService   String?
  date          DateTime       @default(now())
  status        String         @default("active")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  companyId     String
  appointments  Appointment[]
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([companyId])
  @@index([phone])
  @@index([name])
  @@map("clients")
}

model Appointment {
  id             String    @id @default(cuid())
  time           String
  date           DateTime
  name           String
  service        String
  status         String    @default("pending")
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  clientId       String?
  companyId      String
  client         Client?   @relation(fields: [clientId], references: [id])
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@map("appointments")
}

model Conversation {
  id            String    @id @default(cuid())
  name          String?
  status        String    @default("OPEN")
  unread        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  companyId     String
  lastMessage   String?
  lastMessageAt DateTime?
  phone         String
  state         Json?
  clientId      String?
  handledById   String?
  handledAt     DateTime?
  client        Client?   @relation(fields: [clientId], references: [id])
  handledBy     User?     @relation("ConversationHandledBy", fields: [handledById], references: [id])
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@index([companyId])
  @@index([status])
  @@index([phone])
  @@index([handledById])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  role           String
  content        String
  type           String       @default("text")
  createdAt      DateTime     @default(now())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Upload {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  url          String
  createdAt    DateTime @default(now())
  companyId    String
  uploadedById String?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@map("uploads")
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  description String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  screen      String?
  createdAt   DateTime @default(now())
  companyId   String
  userId      String?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([action])
  @@index([userId])
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([companyId])
  @@map("api_keys")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  event       String
  payload     Json
  signature   String?
  status      String    @default("received")
  processedAt DateTime?
  error       String?
  companyId   String?
  createdAt   DateTime  @default(now())

  @@index([provider, status])
  @@map("webhook_events")
}

model WhatsAppConfig {
  id                String               @id @default(cuid())
  companyId         String               @unique
  phoneNumberId     String
  businessAccountId String
  accessToken       String
  phoneNumber       String
  status            WhatsAppConfigStatus @default(CONNECTED)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
  @@map("whatsapp_configs")
}

model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  price         Int            @default(0)
  currency      String         @default("BRL")
  trialDays     Int            @default(14)
  limits        Json           @default("{}")
  features      String[]       @default([])
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String             @id @default(cuid())
  status          SubscriptionStatus @default(TRIALING)
  startedAt       DateTime           @default(now())
  expiresAt       DateTime?
  nextBillingDate DateTime?
  canceledAt      DateTime?
  couponId        String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  companyId       String             @unique
  planId          String
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan            Plan               @relation(fields: [planId], references: [id])
  coupon          Coupon?            @relation(fields: [couponId], references: [id])
  billingHistory  BillingHistory[]

  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model BillingHistory {
  id             String        @id @default(cuid())
  action         String
  amount         Int           @default(0)
  currency       String        @default("BRL")
  status         String
  description    String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  companyId      String
  subscriptionId String?
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([companyId, createdAt])
  @@map("billing_history")
}

model Coupon {
  id            String         @id @default(cuid())
  code          String         @unique
  discountType  String         @default("PERCENTAGE")
  discountValue Int            @default(0)
  maxUses       Int?
  usedCount     Int            @default(0)
  validUntil    DateTime?
  isActive      Boolean        @default(true)
  allowedPlans  String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@index([code])
  @@map("coupons")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ATTENDANT
  EMPLOYEE
  FINANCIAL
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum PlanType {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum WhatsAppConfigStatus {
  CONNECTED
  DISCONNECTED
}
