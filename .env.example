# Database
DATABASE_URL="postgresql://user:password@localhost:5432/atendeai?schema=public"

# JWT
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Session
SESSION_SECRET="change-me-to-another-random-string"
COOKIE_DOMAIN="localhost"

# Encryption
ENCRYPTION_KEY="32-char-hex-string-for-aes-256"

# Next Auth (OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-nextauth-secret"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Ollama (LLM local) — fallback automático para OpenAI se Ollama estiver offline
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
# AI_PROVIDER="ollama" | "openai" — provider primário
AI_PROVIDER="ollama"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# WhatsApp (Meta Cloud API — credenciais da aplicação)
META_APP_ID=""
META_APP_SECRET="" # App secret da Meta (valida x-hub-signature-256 do webhook)
META_WEBHOOK_VERIFY_TOKEN="" # Verify token do webhook (hub.verify_token)

# Tokens de acesso de cada empresa ficam no banco (WhatsAppConfig), nunca no .env

# SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@atendeai.com"

# Monitoring
SENTRY_DSN=""
BETTER_STACK_TOKEN=""

# Upload
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE="5242880"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# ============================================================================
# Supabase (optional - for RLS, Storage, and Auth at edge)
# ============================================================================
# Create project at https://supabase.com
# Copy values from Settings > API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="company-uploads"

# ============================================================================
# Cloudflare (optional - for CDN, DDoS, WAF)
# ============================================================================
# Set these as secrets via: npx wrangler secret put <NAME>
# Or as environment variables in Cloudflare Dashboard
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""

# ============================================================================
# Security (optional - for replay attack protection, signed URLs)
# ============================================================================
SIGNED_URL_SECRET="change-me-to-a-random-32-char-string"

# ============================================================================
# Rate Limiting (optional - edge rate limiting)
# ============================================================================
# Configured via Cloudflare WAF or this value:
RATE_LIMIT_PER_MINUTE="60"
CRON_SECRET="change-me-to-a-random-string-for-cron-endpoints"
LOGIN_RATE_LIMIT_PER_15MIN="5"
